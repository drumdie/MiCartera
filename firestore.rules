rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Datos cifrados del usuario: el cliente owner puede leer/escribir ciphertext.
    // El plaintext nunca se almacena en Firestore; se descifra/cachea en el dispositivo.
    match /users/{uid}/portfolio/{document=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data._encrypted == true
        && request.resource.data._enc_alg == "fernet-v1"
        && request.resource.data.payload is string;
    }

    match /users/{uid}/meta/{docId} {
      allow read, write: if docId != "avg_costs"
        && docId != "portfolio_history"
        && isOwner(uid);
    }

    // Keywrap: la DEK del usuario ENVUELTA (cifrada) bajo KEK(passphrase) y KEK(recovery).
    // Firestore solo ve ciphertext; los secretos nunca salen del dispositivo. Solo el owner.
    match /users/{uid}/keywrap/{docId} {
      allow read, write: if isOwner(uid);
    }

    // Credenciales del broker: cifradas con la DEK del usuario (device-encrypt). Solo el
    // owner, y la escritura exige ciphertext (igual que portfolio).
    match /users/{uid}/broker/{docId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data._encrypted == true
        && request.resource.data._enc_alg == "fernet-v1"
        && request.resource.data.payload is string;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/catalysts/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/fundamentals/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/securityEvents/{docId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Cotizaciones de mercado: lectura autenticada, escritura solo Admin SDK
    match /market/{document=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // Cola de emails: solo Admin SDK
    match /mail/{docId} {
      allow read, write: if false;
    }
  }
}
